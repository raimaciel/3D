# Copie este arquivo para ".env" e preencha com os valores da SUA conta
# Cloudflare. O passo a passo para obter cada um está em PUBLICAR.md.
#
# O arquivo .env NÃO vai para o repositório (está no .gitignore). Não o
# envie por WhatsApp nem cole em lugar público.

# Nome do Worker. Vira parte do endereço temporário:
# https://SEU-WORKER.SEU-SUBDOMINIO.workers.dev
CF_WORKER_NAME=fabricando3d

# Banco D1. O nome é o que você escolher; o id vem na resposta do comando
# "npx wrangler d1 create" e parece um código com traços.
CF_D1_NOME=fabricando3d
CF_D1_ID=cole-aqui-o-id-que-o-comando-devolveu

# Bucket R2 onde ficam os STL, 3MF e fotos.
CF_R2_BUCKET=fabricando3d-arquivos
